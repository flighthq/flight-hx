{
  "name": "@flighthq/flight-hx",
  "version": "0.6.0",
  "private": true,
  "description": "Haxe externs copied from Flight Rust tooling: native FFI and JS/ESM bindings.",
  "type": "module",
  "scripts": {
    "setup": "node tools/setup-haxe.mjs",
    "rehydrate": "node scripts/rehydrate.mjs",
    "rehydrate:check": "node scripts/rehydrate.mjs --check",
    "rehydrate:update": "node scripts/rehydrate.mjs --update",
    "haxe": "node tools/haxe.mjs",
    "package:haxelib": "node tools/package-haxelib.mjs",
    "generate": "node tools/externs/generate.mjs",
    "generate:check": "node tools/externs/generate.mjs --check",
    "generate:externs": "node tools/externs/generate.mjs",
    "generate:externs:check": "node tools/externs/generate.mjs --check",
    "check:externs:upstream": "node tools/externs/generate.mjs --validate-upstream",
    "gate:surface": "node tools/externs/check.mjs",
    "gate:package": "node tests/migration/package.mjs",
    "gate:native-ffi": "node tests/migration/native.mjs",
    "test:externs-driver": "node --test tools/externs/generate.test.mjs",
    "check": "node tests/migration/all.mjs"
  },
  "devDependencies": {
    "lix": "17.0.4-alpha.0"
  },
  "license": "MIT"
}
