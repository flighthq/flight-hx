<?xml version="1.0" encoding="utf-8"?>
<project>
  <meta title="Flight Particles" package="hq.flight.examples.particles" version="0.0.1" />
  <app main="Main" file="FlightParticles" />
  <window width="800" height="500" fps="60" hardware="true" vsync="true" antialiasing="4" />
  <window hardware="false" if="cairo" />
  <!-- <haxelib name="flight" path="../../" /> -->
  <include path="../../" />
  <classpath name="." />
  <!-- Haxe inlining pushes updateParticleEmitter over Neko's per-function VM stack limit. -->
  <haxedef name="no-inline" if="neko" />
  <haxeflag name="-dce" value="full" />
  <haxelib name="lime" />
</project>
