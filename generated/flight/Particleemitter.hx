  flight._hx._fn.Particleemitter.setParticleEmitter3DParticleVelocity(target, index, vx, vy, vz);
  #elseif (js && flight_esm)
  flight._js._fn.Particleemitter.setParticleEmitter3DParticleVelocity(target, index, vx, vy, vz);
  #elseif cpp
  flight._cpp._fn.Particleemitter.setParticleEmitter3DParticleVelocity(target, index, vx, vy, vz);
  #else
  #error "flight.Particleemitter: no backend — define flight_hx, or js+flight_esm, or target cpp.";
  #end
}

