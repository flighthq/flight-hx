  return flight._hx._fn.Media.setVideoChannelPlaybackRate(channel, value);
  #elseif (js && flight_esm)
  return flight._js._fn.Media.setVideoChannelPlaybackRate(channel, value);
  #elseif cpp
  return flight._cpp._fn.Media.setVideoChannelPlaybackRate(channel, value);
  #else
  #error "flight.Media: no backend — define flight_hx, or js+flight_esm, or target cpp.";
  #end
}

