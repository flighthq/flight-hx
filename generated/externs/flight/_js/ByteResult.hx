package flight._js;

/** Generated by flight-bindgen. A byte result of the TypeScript SDK, which is a `Uint8Array` at
	runtime and converts to and from one implicitly. `free` does nothing: JavaScript memory is
	garbage-collected. */
abstract ByteResult(js.lib.Uint8Array) from js.lib.Uint8Array to js.lib.Uint8Array {
	public var length(get, never):Int;

	inline function get_length():Int {
		return this.length;
	}

	public inline function free():Void {}

	public inline function get(index:Int):Int {
		if (index < 0 || index >= this.length) throw new haxe.Exception('ByteResult index $index is outside 0...${this.length}');
		return this[index];
	}

	public inline function toBytes():haxe.io.Bytes {
		return haxe.io.Bytes.ofData(this.buffer.slice(this.byteOffset, this.byteOffset + this.byteLength));
	}
}
