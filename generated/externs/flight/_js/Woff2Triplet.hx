package flight._js;

abstract Woff2Triplet(Dynamic) {
	public var dx(get, set):Float;
	inline function get_dx():Float return untyped this.dx;
	inline function set_dx(value:Float):Float return untyped this.dx = value;
	public var dy(get, set):Float;
	inline function get_dy():Float return untyped this.dy;
	inline function set_dy(value:Float):Float return untyped this.dy = value;
	public var used(get, set):Int;
	inline function get_used():Int return untyped this.used;
	inline function set_used(value:Int):Int return untyped this.used = value;
}
