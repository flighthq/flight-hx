diff --git a/crates/flight-ffi/native_handles.rs b/crates/flight-ffi/native_handles.rs
new file mode 100644
--- /dev/null
+++ b/crates/flight-ffi/native_handles.rs
@@ -0,0 +1,192 @@
+//! One owning handle representation for every Ref<T>, including trait-object views.
+use std::collections::{BTreeMap, BTreeSet};
+use std::path::Path;
+use std::sync::OnceLock;
+
+static REF_TYPES: OnceLock<BTreeSet<String>> = OnceLock::new();
+static NODES: OnceLock<BTreeMap<String, u8>> = OnceLock::new();
+
+pub fn initialize(crates: &Path, names: &[&str]) {
+    let mut nodes = BTreeMap::new();
+    let mut refs = BTreeSet::new();
+    for name in names {
+        for function in super::collect_pub_fns(&crates.join(name).join("src")) {
+            let Some(ret) = function.ret else { continue; };
+            let resolved = super::resolve_type_alias(&ret);
+            let inner = resolved.strip_prefix("Option<").and_then(|s| s.strip_suffix('>')).unwrap_or(&resolved);
+            if let Some(inner) = inner.strip_prefix("Ref<").and_then(|s| s.strip_suffix('>')) { refs.insert(inner.trim().to_string()); }
+        }
+        let Ok(entries) = std::fs::read_dir(crates.join(name).join("src")) else { continue; };
+        for entry in entries.flatten() {
+            if entry.path().extension().is_none_or(|ext| ext != "rs") || entry.file_name().to_string_lossy().contains("test") { continue; }
+            let Ok(source) = std::fs::read_to_string(entry.path()) else { continue; };
+            let Ok(file) = syn::parse_file(&source) else { continue; };
+            for item in file.items {
+                let (ty, family) = match item {
+                    syn::Item::Impl(item) => {
+                        let Some((_, path, _)) = item.trait_ else { continue; };
+                        let family = match path.segments.last().unwrap().ident.to_string().as_str() {
+                            "Node" => 1, "Node2D" => 2, "Node3D" => 3, _ => continue,
+                        };
+                        let syn::Type::Path(path) = *item.self_ty else { continue; };
+                        (path.path.segments.last().unwrap().ident.to_string(), family)
+                    }
+                    syn::Item::Macro(item) => {
+                        let family = match item.mac.path.segments.last().unwrap().ident.to_string().as_str() {
+                            "impl_node2d" => 2, "impl_node3d" => 3, _ => continue,
+                        };
+                        let Some(token) = item.mac.tokens.into_iter().next() else { continue; };
+                        let Ok(ty) = syn::parse_str::<syn::Ident>(&token.to_string()) else { continue; };
+                        (ty.to_string(), family)
+                    }
+                    _ => continue,
+                };
+                let previous = nodes.entry(ty).or_insert(family);
+                *previous = (*previous).max(family);
+            }
+        }
+    }
+    REF_TYPES.set(refs).expect("Ref types initialized once");
+    NODES.set(nodes).expect("node families initialized once");
+}
+
+pub fn is_node(ty: &str) -> bool { NODES.get().is_some_and(|nodes| nodes.contains_key(ty)) }
+
+pub fn box_ref(value: &str, ret: &str) -> String {
+    let ret = super::resolve_type_alias(ret);
+    let ret = ret.strip_prefix("Option<").and_then(|s| s.strip_suffix('>')).unwrap_or(&ret);
+    let inner = ret.strip_prefix("Ref<").and_then(|s| s.strip_suffix('>')).expect("Ref return").trim();
+    let family = match inner {
+        "dyn Node" => 1, "dyn Node2D" => 2, "dyn Node3D" => 3,
+        _ => NODES.get().and_then(|nodes| nodes.get(inner)).copied().unwrap_or(0),
+    };
+    let mutable = if family == 0 { "" } else { "mut " };
+    let mut out = format!("{{ let arc = {value}; let {mutable}handle = FlightRefHandle::new(arc.clone());");
+    if family != 0 {
+        out.push_str("let node: flight_sdk::NodeRef = arc.clone();");
+        out.push_str("if let Some(view) = flight_sdk::as_node2d_ref(&node) { handle.insert(view); }");
+        out.push_str("if let Some(view) = flight_sdk::as_node3d_ref(&node) { handle.insert(view); }");
+        out.push_str("handle.insert(node);");
+        if family == 2 { out.push_str("let view: flight_sdk::Node2DRef = arc.clone(); handle.insert(view);"); }
+        if family == 3 { out.push_str("let view: flight_sdk::Node3DRef = arc.clone(); handle.insert(view);"); }
+    }
+    out.push_str("handle.into_raw() }");
+    out
+}
+
+pub const RUNTIME: &str = r#"
+static FLIGHT_REF_HANDLES: std::sync::OnceLock<std::sync::Mutex<std::collections::HashSet<usize>>> = std::sync::OnceLock::new();
+fn hx_ref_registry() -> &'static std::sync::Mutex<std::collections::HashSet<usize>> {
+    FLIGHT_REF_HANDLES.get_or_init(Default::default)
+}
+struct FlightRefHandle {
+    views: std::collections::HashMap<std::any::TypeId, Box<dyn std::any::Any + Send + Sync>>,
+}
+impl FlightRefHandle {
+    fn new<R: Send + Sync + 'static>(value: R) -> Self {
+        let mut handle = Self { views: std::collections::HashMap::new() };
+        handle.insert(value);
+        handle
+    }
+    fn insert<R: Send + Sync + 'static>(&mut self, value: R) {
+        self.views.insert(std::any::TypeId::of::<R>(), Box::new(value));
+    }
+    fn into_raw(self) -> *mut std::ffi::c_void {
+        let ptr = Box::into_raw(Box::new(self)) as *mut std::ffi::c_void;
+        hx_ref_registry().lock().unwrap().insert(ptr as usize);
+        ptr
+    }
+}
+fn hx_is_ref(ptr: *const std::ffi::c_void) -> bool {
+    hx_ref_registry().lock().unwrap().contains(&(ptr as usize))
+}
+unsafe fn hx_try_ref<R: Clone + 'static>(ptr: *const std::ffi::c_void) -> Option<R> {
+    let registry = hx_ref_registry().lock().unwrap();
+    if !registry.contains(&(ptr as usize)) { return None; }
+    let handle = unsafe { &*(ptr as *const FlightRefHandle) };
+    handle.views.get(&std::any::TypeId::of::<R>()).and_then(|value| value.downcast_ref::<R>()).cloned()
+}
+unsafe fn hx_ref<R: Clone + 'static>(ptr: *const std::ffi::c_void) -> R {
+    unsafe { hx_try_ref(ptr) }.expect("incompatible or released Flight Ref handle")
+}
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn flight_free_ref(ptr: *mut std::ffi::c_void) {
+    if ptr.is_null() { return; }
+    let existed = hx_ref_registry().lock().unwrap().remove(&(ptr as usize));
+    // Drop outside the registry lock: an SDK destructor may call foreign code.
+    if existed { unsafe { drop(Box::from_raw(ptr as *mut FlightRefHandle)); } }
+}
+"#;
+
+fn ref_info(ty: &str) -> Option<(String, bool, bool)> {
+    let (optional, ty) = if let Some(inner) = ty.strip_prefix("Option<").and_then(|s| s.strip_suffix('>')) { (true, inner) } else { (false, ty) };
+    if ty.starts_with("&mut ") { return None; }
+    let (borrowed, ty) = if let Some(inner) = ty.strip_prefix('&') { (true, inner) } else { (false, ty) };
+    let inner = ty.strip_prefix("Ref<")?.strip_suffix('>')?.trim();
+    if inner.contains('<') || inner.contains("::") || super::SKIP_TYPES.iter().any(|skip| inner.contains(skip)) { return None; }
+    Some((format!("flight_sdk::Ref<{}>", super::qualify_type(inner)), optional, borrowed))
+}
+
+pub fn map_ref_param(name: &str, ty: &str) -> Option<super::MappedParam> {
+    let (_, optional, borrowed) = ref_info(ty)?;
+    let clean = name.trim_start_matches('_');
+    let value = format!("ref_{clean}");
+    let expr = match (optional, borrowed) {
+        (true, true) => format!("{value}.as_ref()"),
+        (false, true) => format!("&{value}"),
+        _ => value,
+    };
+    Some(super::MappedParam { ffi_params: vec![(name.to_string(), "*const std::ffi::c_void".into())], call_expr: expr })
+}
+
+fn borrowed_type(ty: &str) -> Option<(&str, bool)> {
+    let (inner, mutable) = if let Some(inner) = ty.strip_prefix("&mut ") { (inner, true) } else { (ty.strip_prefix('&')?, false) };
+    if inner.contains('<') || inner.contains('[') || inner.contains('(') || inner.contains("::") || inner.contains(' ') || matches!(inner, "String" | "str") || super::is_scalar(inner) { return None; }
+    if !is_node(inner) && !REF_TYPES.get().is_some_and(|types| types.contains(inner)) { return None; }
+    Some((inner, mutable))
+}
+
+pub fn borrowed_expr(name: &str, ty: &str) -> Option<String> {
+    borrowed_type(ty)?;
+    Some(format!("value_{}", name.trim_start_matches('_')))
+}
+
+pub fn bindings(name: &str, ty: &str) -> String {
+    let clean = name.trim_start_matches('_');
+    let ptr = format!("{name} as *const std::ffi::c_void");
+    if let Some((reference, optional, _)) = ref_info(ty) {
+        let value = format!("unsafe {{ hx_ref::<{reference}>({ptr}) }}");
+        return if optional {
+            format!("let ref_{clean} = if {name}.is_null() {{ None }} else {{ Some({value}) }};\n")
+        } else { format!("let ref_{clean} = {value};\n") };
+    }
+    if let Some(trait_name) = super::extract_dyn_trait(ty) {
+        if let Some((_, alias)) = super::DYN_OPAQUE_TRAITS.iter().find(|(n, _)| *n == trait_name) {
+            let mutable = ty.starts_with("&mut ");
+            let (mut_kw, lock) = if mutable { ("mut ", "write") } else { ("", "read") };
+            return format!("let arc_{clean} = unsafe {{ hx_ref::<flight_sdk::{alias}>({ptr}) }};\nlet {mut_kw}guard_{clean} = arc_{clean}.{lock}().unwrap();\nlet dyn_{clean}: &{mut_kw}dyn flight_sdk::{trait_name} = &{mut_kw}*guard_{clean};\n");
+        }
+    }
+    let Some((inner, mutable)) = borrowed_type(ty) else { return String::new(); };
+    let qualified = super::qualify_type(inner);
+    let (mut_kw, lock, guard_access, raw) = if mutable { ("mut ", "write", "as_mut", "*mut") } else { ("", "read", "as_ref", "*const") };
+    if is_node(inner) {
+        let any = if mutable { "as_any_mut().downcast_mut" } else { "as_any().downcast_ref" };
+        format!("let arc_{clean} = unsafe {{ hx_try_ref::<flight_sdk::NodeRef>({ptr}) }};\nlet {mut_kw}guard_{clean} = arc_{clean}.as_ref().map(|arc| arc.{lock}().unwrap());\nlet value_{clean}: &{mut_kw}{qualified} = if let Some(guard) = guard_{clean}.{guard_access}() {{ guard.{any}::<{qualified}>().expect(\"incompatible node kind\") }} else {{ assert!(!hx_is_ref({ptr}), \"incompatible Ref handle\"); unsafe {{ &{mut_kw}*({name} as {raw} {qualified}) }} }};\n")
+    } else {
+        format!("let arc_{clean} = unsafe {{ hx_try_ref::<flight_sdk::Ref<{qualified}>>({ptr}) }};\nlet {mut_kw}guard_{clean} = arc_{clean}.as_ref().map(|arc| arc.{lock}().unwrap());\nlet value_{clean}: &{mut_kw}{qualified} = if let Some(guard) = guard_{clean}.{guard_access}() {{ &{mut_kw}**guard }} else {{ assert!(!hx_is_ref({ptr}), \"incompatible Ref handle\"); unsafe {{ &{mut_kw}*({name} as {raw} {qualified}) }} }};\n")
+    }
+}
+
+pub fn bindings_for(name: &str, ty: &str, expr: &str) -> String {
+    let selected = map_ref_param(name, ty).is_some_and(|mapped| mapped.call_expr == expr)
+        || borrowed_expr(name, ty).is_some_and(|value| value == expr)
+        || expr == format!("dyn_{}", name.trim_start_matches('_'));
+    if selected { bindings(name, ty) } else { String::new() }
+}
+
+pub fn borrowed_or_raw_expr(name: &str, ty: &str) -> String {
+    borrowed_expr(name, ty).unwrap_or_else(|| {
+        if ty.starts_with("&mut ") { format!("unsafe {{ &mut *{name} }}") } else { format!("unsafe {{ &*{name} }}") }
+    })
+}
