+            drop(arc);
+            assert_eq!(flight_get_node_child_count(sprite), 0);
+            let runtime = flight_get_sprite_runtime(sprite as *const flight_sdk::Sprite);
+            let arc = hx_ref::<flight_sdk::Ref<flight_sdk::SpriteRuntime>>(runtime);
+            let runtime_weak = Arc::downgrade(&arc);
+            drop(arc);
+            flight_set_sprite_runtime_local_bounds_texture_version(runtime as *mut flight_sdk::SpriteRuntime, 91);
+            assert_eq!(flight_get_sprite_runtime_local_bounds_texture_version(runtime as *const flight_sdk::SpriteRuntime), 91);
+            let cloned = flight_clone_sprite(sprite as *const flight_sdk::Sprite);
+            assert_eq!(flight_get_node_child_count(cloned), 0);
+            flight_free_ref(cloned);
+            flight_free_ref(runtime);
+            assert!(runtime_weak.upgrade().is_some());
+            flight_free_ref(sprite);
+            assert!(weak.upgrade().is_none(), "a boxed Arc view leaked");
+            assert!(runtime_weak.upgrade().is_none(), "runtime handle leaked");
+            flight_free_ref(std::ptr::null_mut());
+        }
+    }
+
+    #[test]
+    fn hierarchy_results_remain_usable_and_own_independent_ref_handles() {
+        unsafe {
+            let parent = flight_create_display_object();
+            let child = flight_create_sprite();
+            let added = flight_add_node_child(parent, child);
+            assert_eq!(flight_get_node_child_count(parent), 1);
+            let parent_view = flight_get_node_parent(added);
+            assert!(!parent_view.is_null());
+            assert_eq!(flight_get_node_child_count(parent_view), 1);
+            let runtime = flight_get_sprite_runtime(added as *const flight_sdk::Sprite);
+            flight_free_ref(runtime);
+            let removed = flight_remove_node_child(parent_view, added);
+            assert_eq!(flight_get_node_child_count(parent), 0);
+            assert!(flight_get_node_parent(removed).is_null());
+            for ptr in [removed, parent_view, added, child, parent] { flight_free_ref(ptr); }
+        }
+    }
+}
