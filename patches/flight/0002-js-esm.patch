+pub fn generate(exports: &[CrateExports], out_dir: &Path, ffi_names: Option<&BTreeSet<String>>) {
+    let js_dir = out_dir.join("flight").join("_js");
+    let fn_dir = js_dir.join("_fn");
+    fs::create_dir_all(&fn_dir).unwrap();
+    let mut types = BTreeSet::new();
+    for package in exports {
+        for func in &package.fns { collect_opaque_types(func, &mut types); }
+        for s in &package.structs { types.insert(s.name.clone()); }
+    }
+    let structs = build_struct_map(exports);
+    let methods = build_type_methods(exports, &types);
+    for ty in &types {
+        let content = emit_type(ty, structs.get(ty.as_str()).copied(),
+            methods.get(ty).map(|v| v.as_slice()).unwrap_or(&[]), ffi_names);
+        write_if_changed(&js_dir.join(format!("{ty}.hx")), &content);
+    }
+    for package in exports {
+        let module = crate_dir_to_module(&package.dir_name);
+        let mut content = format!("package {PKG}._fn;\n\n@:jsRequire(\"@flighthq/{}\")\nextern class {module} {{\n",
+            package.dir_name.strip_prefix("flight-").unwrap_or(&package.dir_name));
