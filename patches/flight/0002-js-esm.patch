         }
+        content.push_str("}\n");
+        if count > 0 { write_if_changed(&fn_dir.join(format!("{module}.hx")), &content); }
     }
-    out
+    eprintln!("wrote JavaScript ESM bindings for {} packages and {} types", exports.len(), types.len());
