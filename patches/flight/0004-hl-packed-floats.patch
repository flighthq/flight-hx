--- a/crates/flight-bindgen/src/haxe_hl.rs
+++ b/crates/flight-bindgen/src/haxe_hl.rs
@@ -373,6 +373,34 @@ fn emit_function(func: &ParsedFn) -> Option<String> {
     }
 
     let params_str = haxe_params.join(", ");
+    let floating = |p: &&String| p.ends_with(":Single") || p.ends_with(":Float");
+    let float_count = haxe_params.iter().filter(floating).count();
+    if float_count > 6 {
+        let native_name = format!("__flightPacked_{haxe_name}");
+        let mut native_params = Vec::new();
+        let mut native_args = Vec::new();
+        let mut stores = String::new();
+        let mut float_index = 0;
+        for param in &haxe_params {
+            let (name, _) = param.split_once(':').expect("typed Haxe parameter");
+            if floating(&param) {
+                if float_index == 0 {
+                    native_params.push("__flightValues:hl.NativeArray<Float>".to_string());
+                    native_args.push("__flightValues".to_string());
+                }
+                writeln!(stores, "\t\t__flightValues[{float_index}] = {name};").unwrap();
+                float_index += 1;
+            } else {
+                native_params.push(param.clone());
+                native_args.push(name.to_string());
+            }
+        }
+        let ret = if matches!(ret_kind, ReturnKind::Void) { "" } else { "return " };
+        return Some(format!(
+            "\t@:hlNative(\"{LIB_NAME}\", \"{ffi_name}\")\n\tprivate static function {native_name}({}):{haxe_ret};\n\tpublic static inline function {haxe_name}({params_str}):{haxe_ret} {{\n\t\tvar __flightValues = new hl.NativeArray<Float>({float_count});\n{stores}\t\t{ret}{native_name}({});\n\t}}",
+            native_params.join(", "), native_args.join(", ")
+        ));
+    }
     Some(format!(
         "\t@:hlNative(\"{LIB_NAME}\", \"{ffi_name}\")\n\tpublic static function {haxe_name}({params_str}):{haxe_ret};"
     ))
@@ -455,3 +483,32 @@ mod hl_tuple_tests {
         assert!(emit_function(&function).is_none());
     }
 }
+
+#[cfg(test)]
+mod packed_float_tests {
+    use super::*;
+    use crate::parse::Param;
+
+    fn matrix(count: usize) -> ParsedFn {
+        let mut params = vec![Param { name: "out".into(), ty: "&mut Matrix4".into() }];
+        params.extend((0..count).map(|i| Param { name: format!("v{i}"), ty: "f32".into() }));
+        ParsedFn { name: "set_matrix4".into(), source_name: Some("set_matrix4".into()), params, ret: None }
+    }
+
+    #[test]
+    fn large_float_calls_keep_public_signature_and_pack_only_native_carrier() {
+        let output = emit_function(&matrix(16)).unwrap();
+        assert!(output.contains("__flightPacked_setMatrix4(out:flight._hl.Matrix4, __flightValues:hl.NativeArray<Float>)"));
+        assert!(output.contains("public static inline function setMatrix4(out:flight._hl.Matrix4, v0:Single"));
+        assert!(output.contains("new hl.NativeArray<Float>(16)"));
+        assert!(output.contains("__flightValues[15] = v15;"));
+        assert!(output.contains("__flightPacked_setMatrix4(out, __flightValues)"));
+    }
+
+    #[test]
+    fn six_float_parameters_keep_the_existing_native_signature() {
+        let output = emit_function(&matrix(6)).unwrap();
+        assert!(!output.contains("__flightPacked"));
+        assert!(output.contains("v5:Single"));
+    }
+}
