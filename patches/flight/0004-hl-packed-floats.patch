diff --git a/crates/flight-ffi/native_bindings.rs b/crates/flight-ffi/native_bindings.rs
--- a/crates/flight-ffi/native_bindings.rs
+++ b/crates/flight-ffi/native_bindings.rs
@@ -59,11 +59,28 @@
         let mut hl_params = Vec::new();
         let mut call_args = Vec::new();
         let mut signatures = Vec::new();
+        // HashLink's native call bridge corrupts spilled floating-point args.
+        // Keep the C ABI intact and carry large floating argument lists in one
+        // GC-rooted NativeArray<Float>, unpacked only inside this HL adapter.
+        let packed = function.sig.inputs.iter().filter(|argument| {
+            let FnArg::Typed(parameter) = argument else { return false; };
+            matches!(carrier(&parameter.ty).signature, "_F32" | "_F64")
+        }).count() > 6;
+        let mut float_index = 0;
         for (index, argument) in function.sig.inputs.iter().enumerate() {
             let FnArg::Typed(parameter) = argument else { panic!("C ABI receiver"); };
             let ty = carrier(&parameter.ty);
             let arg = format!("arg{index}");
             c_params.push(format!("{} {arg}", ty.c));
+            if packed && matches!(ty.signature, "_F32" | "_F64") {
+                if float_index == 0 {
+                    hl_params.push("varray *flight_values".into());
+                    signatures.push("_ARR");
+                }
+                call_args.push(format!("({})hl_aptr(flight_values, double)[{float_index}]", ty.c));
+                float_index += 1;
+                continue;
+            }
             hl_params.push(format!("{} {arg}", ty.hl));
             call_args.push(format!("({}){arg}", ty.c));
             signatures.push(ty.signature);
diff --git a/crates/flight-bindgen/src/haxe_hl.rs b/crates/flight-bindgen/src/haxe_hl.rs
--- a/crates/flight-bindgen/src/haxe_hl.rs
+++ b/crates/flight-bindgen/src/haxe_hl.rs
@@ -363,6 +363,34 @@
     let haxe_ret = return_kind_to_haxe(&ret_kind);
 
     let params_str = haxe_params.join(", ");
+    let floating = |p: &&String| p.ends_with(":Single") || p.ends_with(":Float");
+    let float_count = haxe_params.iter().filter(floating).count();
+    if float_count > 6 {
+        let native_name = format!("__flightPacked_{haxe_name}");
+        let mut native_params = Vec::new();
+        let mut native_args = Vec::new();
+        let mut stores = String::new();
+        let mut float_index = 0;
+        for param in &haxe_params {
+            let (name, _) = param.split_once(':').expect("typed Haxe parameter");
+            if floating(&param) {
+                if float_index == 0 {
+                    native_params.push("__flightValues:hl.NativeArray<Float>".to_string());
+                    native_args.push("__flightValues".to_string());
+                }
+                writeln!(stores, "\t\t__flightValues[{float_index}] = {name};").unwrap();
+                float_index += 1;
+            } else {
+                native_params.push(param.clone());
+                native_args.push(name.to_string());
+            }
+        }
+        let ret = if matches!(ret_kind, ReturnKind::Void) { "" } else { "return " };
+        return Some(format!(
+            "\t@:hlNative(\"{LIB_NAME}\", \"{ffi_name}\")\n\tprivate static function {native_name}({}):{haxe_ret};\n\tpublic static inline function {haxe_name}({params_str}):{haxe_ret} {{\n\t\tvar __flightValues = new hl.NativeArray<Float>({float_count});\n{stores}\t\t{ret}{native_name}({});\n\t}}",
+            native_params.join(", "), native_args.join(", ")
+        ));
+    }
     Some(format!(
         "\t@:hlNative(\"{LIB_NAME}\", \"{ffi_name}\")\n\tpublic static function {haxe_name}({params_str}):{haxe_ret};"
     ))
