+
+/// UTF8 string fields always cross the native boundary through owned buffers and borrowed input bytes.
+pub fn emit_string_field(output: &mut String, ty: &str, name: &str, hl: bool) {
+    let pointer = if hl { "bytes.getData().bytes" } else { "cast cpp.Pointer.ofArray(bytes.getData()).raw" };
+    writeln!(output, "\tinline function get_{name}():String {{\n\t\tfinal bytes = {ty}_Ffi.get_{name}(this);\n\t\ttry {{\n\t\t\tfinal value = bytes.toBytes().toString();\n\t\t\tbytes.dispose();\n\t\t\treturn value;\n\t\t}} catch (error:Dynamic) {{ bytes.dispose(); throw error; }}\n\t}}\n\tinline function set_{name}(value:String):String {{\n\t\tfinal bytes = haxe.io.Bytes.ofString(value);\n\t\t{ty}_Ffi.set_{name}(this, {pointer}, bytes.length);\n\t\treturn value;\n\t}}\n").unwrap();
+}
+pub fn emit_string_ffi(output: &mut String, ty: &str, field: &str, hl: bool) {
+    let snake = crate::haxe_common::to_snake_case(ty);
+    let name = crate::parse::to_camel_case(field);
+    let pointer = if hl { "hl.Bytes" } else { "cpp.Star<cpp.Void>" };
+    let package = if hl { "flight._hl" } else { "flight._cpp" };
+    for (method, symbol, parameters, result) in [
+        (format!("get_{name}"), format!("flight_field_get_{snake}_{field}"), format!("ptr:{pointer}"), format!("{package}.NativeByteBuffer")),
+        (format!("set_{name}"), format!("flight_field_set_{snake}_{field}"), format!("ptr:{pointer}, data:{pointer}, length:Int"), "Void".into())
+    ] {
+        let metadata = if hl { format!("@:hlNative(\"flight\", \"{symbol}\")") } else { format!("@:native(\"{symbol}\")") };
+        writeln!(output, "\t{metadata}\n\tstatic function {method}({parameters}):{result};").unwrap();
+    }
+}
