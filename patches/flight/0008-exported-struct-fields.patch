+#[cfg(test)]
+mod field_tests {
+    use super::*;
+    #[test]
+    fn strings_copy_utf8_and_glob_exported_scalar_fields_are_accessible() {
+        unsafe {
+            let font = flight_create_font_resource();
+            let input = "Sans Ω\0Face".as_bytes();
+            flight_field_set_font_resource_family(font, input.as_ptr(), input.len());
+            let snapshot = flight_field_get_font_resource_family(font);
+            assert_eq!(flight_get_byte_buffer_length(snapshot), input.len());
+            flight_field_set_font_resource_family(font, std::ptr::null(), 0);
+            let empty = flight_field_get_font_resource_family(font);
+            assert_eq!(flight_get_byte_buffer_length(empty), 0);
+            flight_free_byte_buffer(empty);
+            flight_free_font_resource(font);
+            let mut copied = vec![0; input.len()];
+            assert_eq!(flight_copy_byte_buffer(snapshot, copied.as_mut_ptr(), copied.len()), input.len());
+            assert_eq!(copied, input, "string getter must own a copy independent of its source");
+            flight_free_byte_buffer(snapshot);
+            let mut color = flight_sdk::materials::color_scale_bias::create_color_scale_bias();
+            assert_eq!(flight_get_color_scale_bias_red_scale(&color), 1.0);
+            flight_set_color_scale_bias_red_scale(&mut color, 0.25);
+            flight_set_color_scale_bias_blue_bias(&mut color, 0.75);
+            assert_eq!(color.red_scale, 0.25);
+            assert_eq!(flight_get_color_scale_bias_blue_bias(&color), 0.75);
+        }
+    }
+}
