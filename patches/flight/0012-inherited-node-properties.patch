index 0000000000000000000000000000000000000000..c30661a0efbcd8d2acc0fbfb547f1d4424841772
--- /dev/null
+++ b/crates/flight-ffi/node_properties.rs
@@ -0,0 +1,27 @@
+// Each property explicitly defines a trait, carrier, and invalidation policy.
+#[derive(Clone, Copy)]
+pub enum Carrier {
+    Float,
+    Bool,
+    NullableString,
+}
+
+pub struct Property {
+    pub field: &'static str,
+    pub node_2d: bool,
+    pub carrier: Carrier,
+    pub appearance: bool,
+}
+
+impl Property {
+    pub fn symbol(&self, access: &str, snake_type: &str) -> String {
+        format!("flight_node_property_{access}_{snake_type}_{}", self.field)
+    }
+}
+
+pub const PROPERTIES: &[Property] = &[
+    Property { field: "name", node_2d: false, carrier: Carrier::NullableString, appearance: false },
+    Property { field: "alpha", node_2d: true, carrier: Carrier::Float, appearance: true },
+    Property { field: "visible", node_2d: true, carrier: Carrier::Bool, appearance: true },
+    Property { field: "blend_mode", node_2d: true, carrier: Carrier::NullableString, appearance: true },
+];
diff --git a/crates/flight-ffi/node_property_wrappers.rs b/crates/flight-ffi/node_property_wrappers.rs
new file mode 100644
index 0000000000000000000000000000000000000000..fbe6b5b53950fa8ad64d3711e5b9d9d8923cd631
--- /dev/null
+++ b/crates/flight-ffi/node_property_wrappers.rs
@@ -0,0 +1,40 @@
+use std::fmt::Write as _;
+
+use super::node_properties::{Carrier, PROPERTIES};
+
+pub fn emit(output: &mut String, nodes: impl Iterator<Item = (&'static str, bool)>) {
+    for (ty, is_2d) in nodes {
+        let snake = super::to_snake_case(ty);
+        for property in PROPERTIES.iter().filter(|p| is_2d || !p.node_2d) {
+            let field = property.field;
+            let (reference, fields) = if property.node_2d {
+                ("Node2DRef", "node2d_fields")
+            } else {
+                ("NodeRef", "node_fields")
+            };
+            let view = format!(
+                "unsafe {{ hx_try_ref::<flight_sdk::{reference}>(ptr) }}.expect(\"expected a live Flight {reference} handle\")"
+            );
+            let (ret, value, args, assign, ownership) = match property.carrier {
+                Carrier::Float => ("f32", "", ", value: f32", "value", String::new()),
+                Carrier::Bool => ("bool", "", ", value: bool", "value", String::new()),
+                Carrier::NullableString => (
+                    "*mut std::ffi::c_void",
+                    ".as_ref().map_or(std::ptr::null_mut(), |value| hx_byte_buffer(value.bytes()))",
+                    ", data: *const u8, length: usize, present: bool",
+                    "present.then(|| String::from_utf8_lossy(unsafe { ffi_slice_from_raw_parts(data, length) }).into_owned())",
+                    super::ownership_doc("owned-return", "flight_free_byte_buffer", "std::ffi::c_void"),
+                ),
+            };
+            let getter = property.symbol("get", &snake);
+            let setter = property.symbol("set", &snake);
+            let invalidate = if property.appearance {
+                "let runtime = node.node_runtime_mut(); runtime.appearance_id = runtime.appearance_id.wrapping_add(1);"
+            } else {
+                ""
+            };
+            writeln!(output, "{ownership}#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn {getter}(ptr: *const std::ffi::c_void) -> {ret} {{\n    let node = {view};\n    return node.read().unwrap().{fields}().{field}{value};\n}}").unwrap();
+            writeln!(output, "#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn {setter}(ptr: *const std::ffi::c_void{args}) {{\n    let value = {assign};\n    let node = {view};\n    let mut node = node.write().unwrap();\n    node.{fields}_mut().{field} = value;\n    {invalidate}\n}}").unwrap();
+        }
+    }
+}
