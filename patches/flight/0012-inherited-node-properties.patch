diff --git a/crates/flight-bindgen/src/inherited_properties.rs b/crates/flight-bindgen/src/inherited_properties.rs
new file mode 100644
index 0000000000000000000000000000000000000000..aaf68470633ad8871e50aaca6207cb7093df708b
--- /dev/null
+++ b/crates/flight-bindgen/src/inherited_properties.rs
@@ -0,0 +1,78 @@
+use std::collections::BTreeSet;
+use std::fmt::Write as _;
+
+use crate::haxe_common::to_snake_case;
+use crate::node_properties::{Carrier, PROPERTIES, Property};
+use crate::parse::to_camel_case;
+
+pub fn for_type(ty: &str, ffi_names: Option<&BTreeSet<String>>) -> Vec<&'static Property> {
+    let snake = to_snake_case(ty);
+    PROPERTIES.iter().filter(|property| {
+        ffi_names.is_some_and(|names| {
+            names.contains(&property.symbol("get", &snake))
+                && names.contains(&property.symbol("set", &snake))
+        })
+    }).collect()
+}
+
+pub fn collect_handle_type(
+    func: &crate::parse::ParsedFn,
+    types: &mut BTreeSet<String>,
+    ffi_names: Option<&BTreeSet<String>>,
+) {
+    if let Some(ty) = func.ret.as_deref().and_then(crate::parse::ref_return_type) {
+        if !for_type(&ty, ffi_names).is_empty() {
+            types.insert(ty);
+        }
+    }
+}
+
+fn haxe_type(property: &Property, js: bool) -> &'static str {
+    match property.carrier {
+        Carrier::Float if js => "Float",
+        Carrier::Float => "Single",
+        Carrier::Bool => "Bool",
+        Carrier::NullableString => "Null<String>",
+    }
+}
+
+pub fn emit_ffi(output: &mut String, ty: &str, properties: &[&Property], hl: bool) {
+    if properties.is_empty() { return; }
+    let snake = to_snake_case(ty);
+    let pointer = if hl { "hl.Bytes" } else { "cpp.Star<cpp.Void>" };
+    writeln!(output, "private extern class {ty}_NodeProperties {{").unwrap();
+    for property in properties {
+        let name = to_camel_case(property.field);
+        let (ret, args) = match property.carrier {
+            Carrier::NullableString => (
+                "Null<NativeByteBuffer>",
+                format!(", data:{pointer}, length:Int, present:Bool"),
+            ),
+            _ => (haxe_type(property, false), format!(", value:{}", haxe_type(property, false))),
+        };
+        for (access, args, ret) in [("get", String::new(), ret), ("set", args, "Void")] {
+            let symbol = property.symbol(access, &snake);
+            let metadata = if hl { format!("@:hlNative(\"flight\", \"{symbol}\")") } else { format!("@:native(\"{symbol}\")") };
+            writeln!(output, "\t{metadata}\n\tstatic function {access}_{name}(ptr:{pointer}{args}):{ret};").unwrap();
+        }
+    }
+    writeln!(output, "}}\n").unwrap();
+}
+
+pub fn emit_fields(output: &mut String, ty: &str, properties: &[&Property], target: &str) {
+    for property in properties {
+        let name = to_camel_case(property.field);
+        let haxe_ty = haxe_type(property, target == "js");
+        let ffi = format!("{ty}_NodeProperties");
+        writeln!(output, "\tpublic var {name}(get, set):{haxe_ty};").unwrap();
+        if target == "js" {
+            let invalidate = if property.appearance { " flight.Node.invalidateNodeAppearance(this);" } else { "" };
+            writeln!(output, "\tinline function get_{name}():{haxe_ty} return untyped this.{name};\n\tinline function set_{name}(value:{haxe_ty}):{haxe_ty} {{ untyped this.{name} = value;{invalidate} return value; }}\n").unwrap();
+        } else if matches!(property.carrier, Carrier::NullableString) {
+            let pointer = if target == "hl" { "bytes.getData().bytes" } else { "cast cpp.Pointer.ofArray(bytes.getData()).raw" };
+            writeln!(output, "\tinline function get_{name}():{haxe_ty} {{\n\t\tfinal buffer = {ffi}.get_{name}(this);\n\t\tif (buffer == null) return null;\n\t\ttry {{\n\t\t\tfinal value = buffer.toBytes().toString();\n\t\t\tbuffer.dispose();\n\t\t\treturn value;\n\t\t}} catch (error:Dynamic) {{ buffer.dispose(); throw error; }}\n\t}}\n\tinline function set_{name}(value:{haxe_ty}):{haxe_ty} {{\n\t\tif (value == null) {{\n\t\t\t{ffi}.set_{name}(this, null, 0, false);\n\t\t}} else {{\n\t\t\tfinal bytes = haxe.io.Bytes.ofString(value);\n\t\t\t{ffi}.set_{name}(this, {pointer}, bytes.length, true);\n\t\t}}\n\t\treturn value;\n\t}}\n").unwrap();
+        } else {
+            writeln!(output, "\tinline function get_{name}():{haxe_ty} return {ffi}.get_{name}(this);\n\tinline function set_{name}(value:{haxe_ty}):{haxe_ty} {{ {ffi}.set_{name}(this, value); return value; }}\n").unwrap();
+        }
+    }
+}
