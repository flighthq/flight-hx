+mod native_abi_tests {
+    use super::*;
+    #[test]
+    fn closure_arrow_preserves_following_parameters() {
+        let function = parse_fn_signature("pub fn random_exponential(random: &dyn Fn() -> f32, rate: Option<f32>) -> f32 {").unwrap();
+        assert_eq!(function.params.len(), 2);
+        assert_eq!(function.params[1].name, "rate");
+        assert_eq!(function.params[0].ty, "&dyn Fn() -> f32");
+    }
+    #[test]
+    fn fixed_struct_arrays_have_no_length_carrier() {
+        assert!(matches!(classify_param("&mut [Vector3; 8]"), Some(ParamKind::FixedArrayMut(_, 8))));
+    }
+    #[test]
+    fn optional_unsigned_input_matches_wide_ffi_sentinel() {
+        assert!(matches!(classify_param("Option<u32>"), Some(ParamKind::Scalar(ref t)) if t == "i64"));
+        assert!(matches!(classify_return("Option<i32>"), Some(ReturnKind::Scalar(ref t)) if t == "i64"));
+    }
+    #[test]
+    fn guard_clock_alias_uses_callback_and_context() {
+        assert!(matches!(classify_param("NodeGuardClock"), Some(ParamKind::Closure)));
+    }
