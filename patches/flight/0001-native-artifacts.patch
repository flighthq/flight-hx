diff --git a/crates/flight-ffi/native_bindings.rs b/crates/flight-ffi/native_bindings.rs
new file mode 100644
index 0000000..aec8cb5
--- /dev/null
+++ b/crates/flight-ffi/native_bindings.rs
@@ -0,0 +1,86 @@
+// Emit native artifacts from the exact Rust C ABI surface, including generated accessors/frees.
+// This belongs with flight-ffi, rather than a downstream Haxe-signature approximation.
+use std::fmt::Write;
+use std::path::Path;
+use syn::{FnArg, Item, ReturnType, Type};
+
+struct Carrier { c: String, hl: &'static str, signature: &'static str }
+
+fn carrier(ty: &Type) -> Carrier {
+    match ty {
+        Type::Ptr(pointer) => {
+            let is_char = matches!(&*pointer.elem, Type::Path(p) if p.path.segments.last().is_some_and(|s| s.ident == "c_char"));
+            let c = if is_char {
+                if pointer.const_token.is_some() { "const char *" } else { "char *" }
+            } else {
+                // Expose SDK pointers as opaque C carriers, matching the generated Haxe handles.
+                "void *"
+            };
+            Carrier { c: c.into(), hl: "vbyte *", signature: "_BYTES" }
+        }
+        Type::BareFn(_) => Carrier { c: "void *".into(), hl: "vbyte *", signature: "_BYTES" },
+        Type::Path(p) => {
+            let last = p.path.segments.last().unwrap();
+            if last.ident == "Option" {
+                let syn::PathArguments::AngleBracketed(args) = &last.arguments else { panic!("Option ABI"); };
+                let Some(syn::GenericArgument::Type(Type::BareFn(_))) = args.args.first() else { panic!("unsupported Option ABI"); };
+                return Carrier { c: "void *".into(), hl: "vbyte *", signature: "_BYTES" };
+            }
+            let (c, hl, signature) = match last.ident.to_string().as_str() {
+                "f32" => ("float", "float", "_F32"),
+                "f64" => ("double", "double", "_F64"),
+                "bool" => ("bool", "bool", "_BOOL"),
+                "i8" => ("int8_t", "int", "_I32"), "u8" => ("uint8_t", "int", "_I32"),
+                "i16" => ("int16_t", "int", "_I32"), "u16" => ("uint16_t", "int", "_I32"),
+                "i32" => ("int32_t", "int", "_I32"), "u32" => ("uint32_t", "int", "_I32"),
+                "i64" => ("int64_t", "int64", "_I64"), "u64" => ("uint64_t", "int64", "_I64"),
+                "isize" => ("intptr_t", "int", "_I32"), "usize" => ("size_t", "int", "_I32"),
+                _ => panic!("unsupported ABI carrier {}", last.ident),
+            };
+            Carrier { c: c.into(), hl, signature }
+        }
+        _ => panic!("unsupported generated ABI type"),
+    }
+}
+
+pub fn emit(source: &str, out: &Path) {
+    let file = syn::parse_file(source).expect("generated FFI Rust must parse");
+    let mut header = String::from("/* Generated by flight-ffi. Opaque pointers preserve ABI without exposing Rust layouts. */\n#ifndef FLIGHT_FFI_H\n#define FLIGHT_FFI_H\n#include <stdbool.h>\n#include <stdint.h>\n#include <stddef.h>\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n");
+    let mut shim = String::from("/* Generated by flight-ffi for the HashLink native ABI. */\n#define HL_NAME(n) flight_hl_##n\n#include <hl.h>\n#include \"flight_ffi.h\"\n");
+    for item in file.items {
+        let Item::Fn(function) = item else { continue; };
+        if function.sig.abi.as_ref().and_then(|a| a.name.as_ref()).is_none_or(|n| n.value() != "C") { continue; }
+        let name = function.sig.ident.to_string();
+        if !name.starts_with("flight_") { continue; }
+        let result = match &function.sig.output {
+            ReturnType::Default => None, ReturnType::Type(_, ty) => Some(carrier(ty)),
+        };
+        let mut c_params = Vec::new();
+        let mut hl_params = Vec::new();
+        let mut call_args = Vec::new();
+        let mut signatures = Vec::new();
+        for (index, argument) in function.sig.inputs.iter().enumerate() {
+            let FnArg::Typed(parameter) = argument else { panic!("C ABI receiver"); };
+            let ty = carrier(&parameter.ty);
+            let arg = format!("arg{index}");
+            c_params.push(format!("{} {arg}", ty.c));
+            hl_params.push(format!("{} {arg}", ty.hl));
+            call_args.push(format!("({}){arg}", ty.c));
+            signatures.push(ty.signature);
+        }
+        let ret = result.as_ref().map(|r| r.c.as_str()).unwrap_or("void");
+        let hl_ret = result.as_ref().map(|r| r.hl).unwrap_or("void");
+        let ret_signature = result.as_ref().map(|r| r.signature).unwrap_or("_VOID");
+        let c_params = if c_params.is_empty() { "void".into() } else { c_params.join(", ") };
+        let hl_params = if hl_params.is_empty() { "void".into() } else { hl_params.join(", ") };
+        writeln!(header, "{ret} {name}({c_params});").unwrap();
+        let call = format!("{name}({})", call_args.join(", "));
+        let body = if result.is_some() { format!("return ({hl_ret}){call};") } else { format!("{call};") };
+        writeln!(shim, "HL_PRIM {hl_ret} HL_NAME({name})({hl_params}) {{ {body} }}").unwrap();
+        let signature = if signatures.is_empty() { "_NO_ARG".into() } else { signatures.join(" ") };
+        writeln!(shim, "DEFINE_PRIM({ret_signature}, {name}, {signature});").unwrap();
+    }
+    header.push_str("#ifdef __cplusplus\n}\n#endif\n#endif\n");
+    std::fs::write(out.join("flight_ffi.h"), header).unwrap();
+    std::fs::write(out.join("flight_hl.c"), shim).unwrap();
+}
