@@ -0,0 +1,40 @@
+use std::fmt::Write;
+use std::path::Path;
+use crate::parse::ReturnKind;
+use crate::haxe_common::write_if_changed;
+
+pub fn return_type(kind: &ReturnKind, package: &str) -> Option<String> {
+    match kind {
+        ReturnKind::VecReturn(ty) | ReturnKind::BoxSliceReturn(ty) if ty == "u8" => Some(format!("{package}.NativeByteBuffer")),
+        ReturnKind::OptionVecReturn(ty) | ReturnKind::OptionBoxSliceReturn(ty) if ty == "u8" => Some(format!("Null<{package}.NativeByteBuffer>")),
+        _ => None,
+    }
+}
+
+pub fn emit_native(out: &Path, hl: bool) {
+    let package = if hl { "flight._hl" } else { "flight._cpp" };
+    let pointer = if hl { "hl.Bytes" } else { "cpp.Star<cpp.Void>" };
+    let destination = if hl { "result.getData()" } else { "cast cpp.Pointer.ofArray(result.getData()).raw" };
+    let mut source = format!("package {package};\n\n// The result owns its Rust bytes until dispose(); data is a borrowed view.\nprivate extern class NativeByteBuffer_Ffi {{\n");
+    for (method, symbol, parameters, result) in [
+        ("length", "flight_get_byte_buffer_length", format!("ptr:{pointer}"), "Int"),
+        ("data", "flight_get_byte_buffer_data", format!("ptr:{pointer}"), pointer),
+        ("get", "flight_get_byte_buffer_byte", format!("ptr:{pointer}, index:Int"), "Int"),
+        ("copy", "flight_copy_byte_buffer", format!("ptr:{pointer}, destination:{pointer}, capacity:Int"), "Int"),
+        ("free", "flight_free_byte_buffer", format!("ptr:{pointer}"), "Void"),
+    ] {
+        let metadata = if hl { format!("@:hlNative(\"flight\", \"{symbol}\")") } else { format!("@:native(\"{symbol}\")") };
+        writeln!(source, "\t{metadata}\n\tstatic function {method}({parameters}):{result};").unwrap();
+    }
+    writeln!(source, "}}\n\nabstract NativeByteBuffer({pointer}) {{").unwrap();
+    source.push_str("\tpublic var length(get, never):Int;\n\tinline function get_length():Int return NativeByteBuffer_Ffi.length(this);\n");
+    writeln!(source, "\tpublic var data(get, never):{pointer};\n\tinline function get_data():{pointer} return NativeByteBuffer_Ffi.data(this);").unwrap();
+    source.push_str("\tpublic inline function getByte(index:Int):Int {\n\t\tif (index < 0 || index >= length) throw 'Byte buffer index out of bounds';\n\t\treturn NativeByteBuffer_Ffi.get(this, index);\n\t}\n");
+    writeln!(source, "\tpublic inline function toBytes():haxe.io.Bytes {{\n\t\tfinal count = length;\n\t\tfinal result = haxe.io.Bytes.alloc(count);\n\t\tif (count > 0 && NativeByteBuffer_Ffi.copy(this, {destination}, count) != count) throw 'Byte buffer copy failed';\n\t\treturn result;\n\t}}").unwrap();
+    source.push_str("\tpublic inline function dispose():Void { NativeByteBuffer_Ffi.free(this); this = null; }\n}\n");
+    write_if_changed(&out.join(package.replace('.', "/")).join("NativeByteBuffer.hx"), &source);
+}
+
+pub fn emit_dispatch(out: &Path) {
+    write_if_changed(&out.join("flight/NativeByteBuffer.hx"), "package flight;\n\n#if hl\ntypedef NativeByteBuffer = flight._hl.NativeByteBuffer;\n#elseif cpp\ntypedef NativeByteBuffer = flight._cpp.NativeByteBuffer;\n#elseif (js && flight_esm)\ntypedef NativeByteBuffer = js.lib.Uint8Array;\n#else\n#error \"Flight requires cpp, hl, or JS with flight_esm.\"\n#end\n");
+}
