diff --git a/crates/flight-ffi/native_buffers.rs b/crates/flight-ffi/native_buffers.rs
new file mode 100644
--- /dev/null
+++ b/crates/flight-ffi/native_buffers.rs
@@ -0,0 +1,52 @@
+//! Owned u8 results carry explicit data, length and destruction, rather than a boxed fat pointer.
+pub fn is_byte_return(ty: &str) -> bool {
+    let ty = super::strip_crate_paths(&super::resolve_type_alias(ty));
+    let ty = ty.strip_prefix("Option<").and_then(|s| s.strip_suffix('>')).unwrap_or(&ty);
+    matches!(ty, "Vec<u8>" | "Box<[u8]>")
+}
+pub fn wrap(value: &str, ty: &str) -> String {
+    if is_byte_return(ty) { format!("hx_byte_buffer({value})") }
+    else { format!("Box::into_raw(Box::new({value})) as *mut std::ffi::c_void") }
+}
+pub const RUNTIME: &str = r#"
+struct HxByteBuffer { bytes: Vec<u8> }
+static HX_BYTE_BUFFERS: std::sync::OnceLock<std::sync::Mutex<std::collections::HashSet<usize>>> = std::sync::OnceLock::new();
+fn hx_byte_buffers() -> &'static std::sync::Mutex<std::collections::HashSet<usize>> { HX_BYTE_BUFFERS.get_or_init(Default::default) }
+fn hx_byte_buffer(values: impl IntoIterator<Item=u8>) -> *mut std::ffi::c_void {
+    let ptr = Box::into_raw(Box::new(HxByteBuffer { bytes: values.into_iter().collect() })) as *mut std::ffi::c_void;
+    hx_byte_buffers().lock().unwrap().insert(ptr as usize);
+    ptr
+}
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn flight_get_byte_buffer_length(ptr: *const std::ffi::c_void) -> usize {
+    let buffers = hx_byte_buffers().lock().unwrap();
+    if !buffers.contains(&(ptr as usize)) { return 0; }
+    unsafe { &*(ptr as *const HxByteBuffer) }.bytes.len()
+}
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn flight_get_byte_buffer_data(ptr: *mut std::ffi::c_void) -> *mut u8 {
+    let buffers = hx_byte_buffers().lock().unwrap();
+    if !buffers.contains(&(ptr as usize)) { return std::ptr::null_mut(); }
+    unsafe { &mut *(ptr as *mut HxByteBuffer) }.bytes.as_mut_ptr()
+}
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn flight_get_byte_buffer_byte(ptr: *const std::ffi::c_void, index: usize) -> i32 {
+    let buffers = hx_byte_buffers().lock().unwrap();
+    if !buffers.contains(&(ptr as usize)) { return -1; }
+    unsafe { &*(ptr as *const HxByteBuffer) }.bytes.get(index).map(|byte| *byte as i32).unwrap_or(-1)
+}
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn flight_copy_byte_buffer(ptr: *const std::ffi::c_void, destination: *mut u8, capacity: usize) -> usize {
+    let buffers = hx_byte_buffers().lock().unwrap();
+    if !buffers.contains(&(ptr as usize)) || destination.is_null() { return 0; }
+    let bytes = &unsafe { &*(ptr as *const HxByteBuffer) }.bytes;
+    let length = bytes.len().min(capacity);
+    if length != 0 { unsafe { std::ptr::copy(bytes.as_ptr(), destination, length); } }
+    length
+}
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn flight_free_byte_buffer(ptr: *mut std::ffi::c_void) {
+    let existed = hx_byte_buffers().lock().unwrap().remove(&(ptr as usize));
+    if existed { unsafe { drop(Box::from_raw(ptr as *mut HxByteBuffer)); } }
+}
+"#;
