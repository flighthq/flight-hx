+#[cfg(test)]
+mod byte_buffer_tests {
+    use super::*;
+    #[test]
+    fn compression_buffers_report_length_copy_bytes_and_release_storage() {
+        unsafe {
+            let input = [0, 1, 2, 127, 128, 254, 255];
+            let compressed = flight_compress_deflate(input.as_ptr(), input.len());
+            let length = flight_get_byte_buffer_length(compressed);
+            assert!(length > 0);
+            let decoded = flight_decompress_deflate(flight_get_byte_buffer_data(compressed), length, input.len(), 0);
+            assert!(!decoded.is_null());
+            assert_eq!(flight_get_byte_buffer_length(decoded), input.len());
+            let mut copy = vec![0; input.len()];
+            assert_eq!(flight_copy_byte_buffer(decoded, copy.as_mut_ptr(), copy.len()), input.len());
+            assert_eq!(copy, input);
+            assert_eq!(flight_get_byte_buffer_byte(decoded, 6), 255);
+            assert_eq!(flight_get_byte_buffer_byte(decoded, 7), -1);
+            flight_free_byte_buffer(decoded);
+            flight_free_byte_buffer(compressed);
+            let empty = flight_compress_deflate(std::ptr::null(), 0);
+            let decoded = flight_decompress_deflate(flight_get_byte_buffer_data(empty), flight_get_byte_buffer_length(empty), 0, 0);
+            assert!(!decoded.is_null());
+            assert_eq!(flight_get_byte_buffer_length(decoded), 0);
+            flight_free_byte_buffer(decoded);
+            flight_free_byte_buffer(empty);
+            assert!(flight_decompress_deflate(std::ptr::null(), 0, 4, 1).is_null());
+            flight_free_byte_buffer(std::ptr::null_mut());
+        }
+    }
+}
