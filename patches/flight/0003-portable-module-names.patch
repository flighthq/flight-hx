+#[cfg(test)]
+mod portable_module_tests {
+    use super::*;
+    #[test]
+    fn facades_use_canonical_sdk_type_case() {
+        for (module, ty) in [
+            ("motionpath", "MotionPath"), ("movieclip", "MovieClip"),
+            ("physics2d-abi", "Physics2DAbi"), ("physics3d-abi", "Physics3DAbi"),
+            ("quadbatch", "QuadBatch"), ("scene2d", "Scene2D"),
+            ("skeleton2d", "Skeleton2D"), ("textsegment", "TextSegment"),
+            ("textureatlas", "TextureAtlas"),
+        ] {
+            let types = BTreeSet::from([ty.to_string()]);
+            assert_eq!(crate_dir_to_module(&format!("flight-{module}"), &types), ty);
+        }
+        assert_eq!(crate_dir_to_module("flight-geometry", &BTreeSet::new()), "Geometry");
+    }
+}
