+pub fn get_string_field_access(surface: &FfiSurface, getter: &str, setter: &str) -> FieldAccess {
+    FieldAccess {
+        get: surface.c.get(getter).is_some_and(|s| s.ret == "char *" && s.params == ["void *"])
+            && surface.hl.get(getter).is_some_and(|s| s.ret == "_BYTES" && s.params == ["_BYTES"]),
+        set: surface.c.get(setter).is_some_and(|s| s.ret == "void" && s.params == ["void *", "const char *"])
+            && surface.hl.get(setter).is_some_and(|s| s.ret == "_VOID" && s.params == ["_BYTES", "_BYTES"]),
+    }
+}
