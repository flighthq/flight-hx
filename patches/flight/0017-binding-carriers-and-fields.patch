+pub fn emit_string_field(
+    output: &mut String, ffi: &str, name: &str, access: FieldAccess, hl: bool,
+) {
+    writeln!(output, "\t{}", field_property_declaration(name, "String", access)).unwrap();
+    if access.get {
+        let read = if hl {
+            "@:privateAccess String.fromUTF8(raw)"
+        } else {
+            "(cast raw : cpp.ConstCharStar)"
+        };
+        writeln!(output, "\tinline function get_{name}():String {{ var raw = {ffi}.get_{name}(this); if (raw == null) return null; var value:String = {read}; {ffi}.freeString(raw); return value; }}").unwrap();
+    }
+    if access.set {
+        let write = if hl {
+            "var raw:hl.Bytes = null; if (value != null) { var bytes = haxe.io.Bytes.ofString(value); raw = new hl.Bytes(bytes.length + 1); raw.blit(0, bytes.getData(), 0, bytes.length); raw.setUI8(bytes.length, 0); } "
+        } else {
+            "var raw:cpp.ConstCharStar = cast value; "
+        };
+        writeln!(output, "\tinline function set_{name}(value:String):String {{ {write}{ffi}.set_{name}(this, raw); return value; }}").unwrap();
+    }
